# /etc/logrotate.d/hfq : daily rotation, 90 days kept (the retention promised in the Terms), compressed, admin-only
/var/log/nginx/hfq.access.log /var/log/nginx/hfq.error.log {
    daily
    rotate 90
    maxage 90
    missingok
    notifempty
    compress
    delaycompress
    create 0640 www-data adm
    sharedscripts
    postrotate
        [ -f /var/run/nginx.pid ] && kill -USR1 `cat /var/run/nginx.pid`
    endscript
}
